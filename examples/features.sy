// Additional language coverage. Inputs are restricted to [-100, 100].
const int WIDTH = 5;
int calls = 0;
int touch(int x) {
    calls = calls + 1;
    return x;
}
int reduce(int a[], int n) {
    int i = 0;
    int sum = 0;
    while (i < n) {
        if (a[i] == 0) break;
        if (a[i] < 0) {
            i = i + 1;
            continue;
        }
        sum = sum + a[i];
        i = i + 1;
    }
    return sum;
}
int blend(float x, float y) {
    float half = 0.5;
    float two = 2.0;
    float z = ((x + half) * two - y) / two;
    int r = z;
    return r;
}
void emit(int x) {
    putint(x);
    putch(10);
}
int main() {
    int x = getint();
    int d = getint();
    int a[5] = {x, -2, d, 0, 9};
    emit(+x + d);
    emit(x - d);
    emit(x * d);
    if (d != 0) {
        emit(x / d);
        emit(x % d);
    } else {
        emit(0);
        emit(0);
    }
    if (x < 0) emit(-1);
    else if (x == 0) emit(0);
    else emit(1);
    if (d != 0 && x / d > 1) emit(1);
    else emit(0);
    if (d == 0 || touch(x) != 0) emit(1);
    else emit(0);
    emit(calls);
    if (!(x <= d) && x >= 0) emit(1);
    else emit(0);
    emit(reduce(a, WIDTH));
    emit(blend(x, d));
    emit(-x);
    {
        int x = d + 1;
        emit(x);
    }
    emit(x);
    return 0;
}
